---
import '../styles/global.css'
import '../../public/styles.css'
import { AppColors } from '../constants/Colors'

import { getLangFromUrl } from '../i18n/utils'

interface Props {
	title: string
}

const lang = getLangFromUrl(Astro.url)
const { title } = Astro.props
---

<html lang={lang}>
	<head>
		<meta charset='UTF-8' />
		<meta name='description' content='Astro description' />
		<meta name='viewport' content='width=device-width' />
		<link rel='preload' href='/fonts/inter/Inter-Bold.woff2' as='font' type='font/woff2' crossorigin='anonymous' />
		<link rel='preload' href='/fonts/inter/Inter-Medium.woff2' as='font' type='font/woff2' crossorigin='anonymous' />
		<link rel='preload' href='/fonts/inter/Inter-Regular.woff2' as='font' type='font/woff2' crossorigin='anonymous' />

		<meta name='generator' content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class='select-none flex flex-col relative border-green-800 border-0'>
		<slot />
	</body>
</html>

<style is:global define:vars={AppColors.dark}>
	:root {
		/* Astro automatically maps the object keys to --key */
		--background: var(--background);
		--background-raised: var(--backgroundRaised);
		--background-card: var(--backgroundCard);
		--main: var(--main);
		--main-light: var(--mainLight);
		--main-dim: var(--mainDim);
		--main-glow: var(--mainGlow);
		--gold: var(--gold);
		--text: var(--text);
		--text-2: var(--text2);
		--text-3: var(--text3);
		--border: var(--border);
		--border-light: var(--borderLight);
		--error: var(--error);
	}
</style>

<style is:global>
	html {
		font-family: inter;
	}
	code {
		font-family: inter;
	}
</style>
