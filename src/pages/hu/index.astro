<style is:global>
  body {
    background-color: #0c0c0f;
    margin: 0;
  }
</style>

<style>
  /* Pulse animation for the live dot */
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(94,189,138,0.8); }
    50% { opacity: 0.5; box-shadow: 0 0 3px rgba(94,189,138,0.3); }
  }
  .pulse-dot {
    animation: pulse 2s ease-in-out infinite;
  }

  /* Hero entrance animations */
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInRight {
    from { opacity: 0; transform: translateX(40px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  .hero-badge   { animation: fadeInUp 0.6s ease-out 0.0s both; }
  .hero-title   { animation: fadeInUp 0.6s ease-out 0.1s both; }
  .hero-subtitle{ animation: fadeInUp 0.6s ease-out 0.2s both; }
  .hero-buttons { animation: fadeInUp 0.6s ease-out 0.3s both; }
  .hero-image   { animation: fadeInRight 0.9s ease-out 0.2s both; }

  /* Scroll-triggered fade-in-up */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.65s ease-out, transform 0.65s ease-out;
  }
  .animate-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Feature card hover */
  .feature-card:hover {
    background: rgba(20,20,23,0.95) !important;
    border-color: rgba(255,255,255,0.12) !important;
    transform: translateY(-4px);
  }

  /* Polaroid hover */
  .polaroid-fg {
    transition: transform 0.4s ease;
  }
  .polaroid-fg:hover {
    transform: rotate(0deg) scale(1.04) !important;
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    { threshold: 0.1, rootMargin: '-40px' }
  );

  document.querySelectorAll('.animate-on-scroll').forEach((el) => {
    observer.observe(el);
  });
</script>
