---
import Layout from '../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import headerLogo from '../../assets/header_logo.png'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

export function getStaticPaths() {
	return [{ params: { lang: 'hu' } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t('impresszum.title')}>
	<div class='min-h-screen text-white' style="background-color: #0c0c0f; font-family: 'DM Sans', sans-serif;">
		<!-- Navigation -->
		<nav
			style='position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: rgba(12,12,15,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.06);'>
			<div
				style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; height: 5rem; display: flex; align-items: center;'>
				<a href={`/${lang}/`} style='display: flex; align-items: center; gap: 0.625rem; text-decoration: none;'>
					<Image
						src={headerLogo}
						alt='Brendo'
						loading='eager'
						widths={[80]}
						sizes='40px'
						style='width: 2.5rem; height: 2.5rem; object-fit: contain;'
					/>
					<span style="font-family: 'Crimson Pro', serif; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; color: white;">Brendo</span>
				</a>
			</div>
		</nav>

		<!-- Content -->
		<main style='max-width: 42rem; margin: 0 auto; padding: 10rem 1.5rem 6rem;'>
			<h1
				style="font-family: 'Crimson Pro', serif; font-size: clamp(2.5rem, 6vw, 3.5rem); font-weight: 700; color: white; margin-bottom: 0.75rem;">
				{t('impresszum.heading')}
			</h1>
			<p style='color: rgba(255,255,255,0.45); margin-bottom: 1.5rem; font-size: 1.125rem;'>
				{t('impresszum.subtitle')}
			</p>
			<p style='color: rgba(255,255,255,0.65); margin-bottom: 4rem; font-size: 1rem; line-height: 1.75;'>
				{t('impresszum.intro')}
			</p>

			<!-- Developer -->
			<section style='margin-bottom: 2.5rem;'>
				<div style='display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;'>
					<div
						style='width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; background: rgba(20,20,23,0.9); border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; flex-shrink: 0;'>
						<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5ebd8a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'
							><circle cx='12' cy='8' r='5'></circle><path d='M3 21a9 9 0 0 1 18 0'></path></svg
						>
					</div>
					<h2 style='color: white; font-weight: 600; font-size: 1.125rem; margin: 0;'>{t('impresszum.developer.heading')}</h2>
				</div>
				<div
					style='background: rgba(20,20,23,0.6); border: 1px solid rgba(255,255,255,0.06); border-radius: 1.25rem; padding: 1.5rem;'>
					<p style='font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); margin-bottom: 0.25rem;'>
						{t('impresszum.developer.name_label')}
					</p>
					<p style='color: white; margin: 0;'>Győrfy Máté</p>
				</div>
			</section>

			<!-- Contact -->
			<section style='margin-bottom: 2.5rem;'>
				<div style='display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.25rem;'>
					<div
						style='width: 2.25rem; height: 2.25rem; border-radius: 0.5rem; background: rgba(20,20,23,0.9); border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; flex-shrink: 0;'>
						<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='#5ebd8a' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'
							><rect width='20' height='16' x='2' y='4' rx='2'></rect><path d='m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7'></path></svg
						>
					</div>
					<h2 style='color: white; font-weight: 600; font-size: 1.125rem; margin: 0;'>{t('impresszum.contact.heading')}</h2>
				</div>
				<div
					style='background: rgba(20,20,23,0.6); border: 1px solid rgba(255,255,255,0.06); border-radius: 1.25rem; padding: 1.5rem;'>
					<p style='font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.3); margin-bottom: 0.25rem;'>
						{t('impresszum.contact.email_label')}
					</p>
					<a
						href='mailto:brendoapptest@gmail.com'
						style='color: #5ebd8a; text-decoration: none; font-weight: 500; display: block; margin-bottom: 1rem;'
						onmouseover="this.style.textDecoration='underline'"
						onmouseout="this.style.textDecoration='none'">
						brendoapptest@gmail.com
					</a>
					<p style='color: rgba(255,255,255,0.3); font-size: 0.875rem; margin: 0;'>
						{t('impresszum.contact.response_time')}
					</p>
				</div>
			</section>

			<a
				href={`/${lang}/`}
				style='color: rgba(255,255,255,0.35); font-size: 0.875rem; text-decoration: none; transition: color 0.2s;'
				onmouseover="this.style.color='#5ebd8a'"
				onmouseout="this.style.color='rgba(255,255,255,0.35)'">
				{t('impresszum.back')}
			</a>
		</main>

		<!-- Footer -->
		<footer style='padding: 2.5rem 0; border-top: 1px solid rgba(255,255,255,0.06); background: rgba(0,0,0,0.45);'>
			<div style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; text-align: center;'>
				<p style='font-size: 0.875rem; color: rgba(255,255,255,0.3); margin: 0;'>
					&copy; {new Date().getFullYear()} Brendo. {t('impresszum.footer_copyright')}
				</p>
			</div>
		</footer>
	</div>
</Layout>

<style is:global>
	body {
		background-color: #0c0c0f;
		margin: 0;
	}
</style>
