---
import Layout from '../../layouts/Layout.astro'
import { Image } from 'astro:assets'
import appScreenshotHu from '../../assets/showcase_hu.png'
import appScreenshotEn from '../../assets/showcase_en.png'
import exploreImage from '../../assets/explore_background.png'
import headerLogo from '../../assets/header_logo.png'
import memoryFg from '../../assets/memory_1.jpg'
import memoryBg from '../../assets/memory_2.jpg'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }, { params: { lang: 'hu' } }]
}

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={t('index.title')}>
	<div class='min-h-screen text-white overflow-x-hidden' style="background-color: #0c0c0f; font-family: 'DM Sans', sans-serif;">
		<!-- Navigation -->
		<nav
			style='position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: rgba(12,12,15,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255,255,255,0.06);'>
			<div
				style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; height: 5rem; display: flex; align-items: center; justify-content: space-between;'>
				<div style='display: flex; align-items: center; gap: 0.625rem;'>
					<Image
						src={headerLogo}
						alt='Brendo'
						loading='eager'
						widths={[520, 800]}
						sizes='(max-width: 768px) 90vw, 520px'
						style='width: 2.5rem; height: 2.5rem; object-fit: contain;'
					/>
					<span style="font-family: 'Crimson Pro', serif; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; color: white;">Brendo</span>
				</div>
				<div class='hidden md:flex' style='align-items: center; gap: 2rem;'>
					<a
						href='#discover'
						style='font-size: 0.875rem; font-weight: 500; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.2s;'
						onmouseover="this.style.color='white'"
						onmouseout="this.style.color='rgba(255,255,255,0.65)'">{t('index.nav.discover')}</a
					>
					<a
						href='#memories'
						style='font-size: 0.875rem; font-weight: 500; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.2s;'
						onmouseover="this.style.color='white'"
						onmouseout="this.style.color='rgba(255,255,255,0.65)'">{t('index.nav.memories')}</a
					>
					<a
						href='#download'
						style='font-size: 0.875rem; font-weight: 500; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.2s;'
						onmouseover="this.style.color='white'"
						onmouseout="this.style.color='rgba(255,255,255,0.65)'">{t('index.nav.download')}</a
					>
				</div>
				<a
					href='#download'
					style='border-radius: 9999px; padding: 0.625rem 1.5rem; background: #5ebd8a; color: black; font-weight: 600; font-size: 0.875rem; text-decoration: none; transition: background 0.2s;'
					onmouseover="this.style.background='#4fa877'"
					onmouseout="this.style.background='#5ebd8a'">
					{t('index.nav.cta')}
				</a>
			</div>
		</nav>

		<!-- Hero Section -->
		<section style='position: relative; padding-top: 7rem; padding-bottom: 3.5rem; overflow: hidden;'>
			<div
				style='position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 800px; height: 800px; background: rgba(94,189,138,0.07); filter: blur(120px); border-radius: 9999px; pointer-events: none;'>
			</div>

			<div style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 10;'>
				<div class='flex flex-col lg:flex-row items-center' style='gap: 4rem;'>
					<div class='flex-1 text-left lg:text-left'>
						<div
							class='hero-badge'
							style='display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; border-radius: 9999px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); margin-bottom: 2rem; backdrop-filter: blur(4px);'>
							<span class='pulse-dot' style='width: 0.5rem; height: 0.5rem; border-radius: 9999px; background: #5ebd8a; display: inline-block;'
							></span>
							<span style='font-size: 0.875rem; font-weight: 500; color: rgba(255,255,255,0.75);'>{t('index.hero.badge')}</span>
						</div>

						<h1
							class='hero-title'
							style="font-family: 'Crimson Pro', serif; font-size: clamp(2rem, 6vw, 4.5rem); font-weight: 700; line-height: 1.1; margin-bottom: 1.5rem; color: white;">
							{t('index.hero.title')}
							<span style='color: var(--gold); font-style: italic;'>{t('index.hero.title_highlight')}</span>
						</h1>

						<p
							class='hero-subtitle'
							style='font-size: 1.125rem; color: rgba(255,255,255,0.55); margin-bottom: 2.5rem; max-width: 38rem; font-weight: 300; line-height: 1.75; margin-left: auto; margin-right: auto;'>
							{t('index.hero.subtitle')}
						</p>

						<div class='hero-buttons flex flex-row sm:flex-row items-center justify-center lg:justify-start' style='gap: 1rem;'>
							<a
								href='#download'
								style='display: flex; align-items: center; justify-content: center; width: 100%; max-width: 16rem; height: 3.5rem; padding: 0 2rem; border-radius: 9999px; background: #5ebd8a; color: black; font-size: 1.0625rem; font-weight: 600; text-decoration: none; box-shadow: 0 0 20px rgba(94,189,138,0.25); border: 1px solid rgba(94,189,138,0.5); transition: background 0.2s;'
								onmouseover="this.style.background='#4fa877'"
								onmouseout="this.style.background='#5ebd8a'">
								{t('index.hero.cta_primary')}
							</a>
							<a
								href='#discover'
								style='display: flex; align-items: center; justify-content: center; width: 100%; max-width: 16rem; height: 3.5rem; padding: 0 2rem; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.2); color: white; font-size: 1.0625rem; font-weight: 500; text-decoration: none; transition: background 0.2s;'
								onmouseover="this.style.background='rgba(255,255,255,0.05)'"
								onmouseout="this.style.background='transparent'">
								{t('index.hero.cta_secondary')}
							</a>
						</div>
					</div>

					<div class='flex-1 hero-image' style='display: flex; justify-content: center;'>
						<Image
							src={lang == 'hu' ? appScreenshotHu : appScreenshotEn}
							alt='Brendo App'
							loading='eager'
							widths={[520, 800]}
							sizes='(max-width: 768px) 90vw, 480px'
							style='width: 100%; max-width: 480px; filter: drop-shadow(0 25px 50px rgba(0,0,0,0.6));'
						/>
					</div>
				</div>
			</div>
		</section>

		<!-- Features Grid -->
		<section
			id='discover'
			style='padding: 6rem 0; background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);'>
			<div style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem;'>
				<div class='animate-on-scroll text-center' style='max-width: 48rem; margin: 0 auto 5rem;'>
					<h2 style="font-family: 'Crimson Pro', serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; margin-bottom: 1.5rem; color: white;">
						{t('index.features.heading')}
					</h2>
					<p style='font-size: 1.125rem; color: rgba(255,255,255,0.55); font-weight: 300;'>
						{t('index.features.subheading')}
					</p>
				</div>

				<div class='grid md:grid-cols-3' style='gap: 2rem;'>
					<div
						class='animate-on-scroll feature-card'
						style='background: rgba(20,20,23,0.6); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.06); padding: 2.5rem; border-radius: 1.5rem; transition: all 0.3s; transition-delay: 0s;'>
						<div
							style='width: 4rem; height: 4rem; border-radius: 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; margin-bottom: 2rem;'>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='28'
								height='28'
								viewBox='0 0 24 24'
								fill='none'
								stroke='#5ebd8a'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><circle cx='12' cy='12' r='10'></circle><polygon points='16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76'
								></polygon></svg
							>
						</div>
						<h3 style="font-family: 'Crimson Pro', serif; font-size: 1.5rem; font-weight: 700; color: white; margin-bottom: 1rem;">
							{t('index.features.discover.title')}
						</h3>
						<p style='color: rgba(255,255,255,0.55); line-height: 1.7; font-weight: 300;'>{t('index.features.discover.desc')}</p>
					</div>

					<div
						class='animate-on-scroll feature-card'
						style='background: rgba(20,20,23,0.6); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.06); padding: 2.5rem; border-radius: 1.5rem; transition: all 0.3s; transition-delay: 0.1s;'>
						<div
							style='width: 4rem; height: 4rem; border-radius: 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; margin-bottom: 2rem;'>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='28'
								height='28'
								viewBox='0 0 24 24'
								fill='none'
								stroke='#5ebd8a'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><polygon points='3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21'></polygon><line x1='9' x2='9' y1='3' y2='18'></line><line
									x1='15'
									x2='15'
									y1='6'
									y2='21'></line></svg
							>
						</div>
						<h3 style="font-family: 'Crimson Pro', serif; font-size: 1.5rem; font-weight: 700; color: white; margin-bottom: 1rem;">
							{t('index.features.travels.title')}
						</h3>
						<p style='color: rgba(255,255,255,0.55); line-height: 1.7; font-weight: 300;'>{t('index.features.travels.desc')}</p>
					</div>

					<div
						class='animate-on-scroll feature-card'
						style='background: rgba(20,20,23,0.6); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.06); padding: 2.5rem; border-radius: 1.5rem; transition: all 0.3s; transition-delay: 0.2s;'>
						<div
							style='width: 4rem; height: 4rem; border-radius: 1rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center; margin-bottom: 2rem;'>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='28'
								height='28'
								viewBox='0 0 24 24'
								fill='none'
								stroke='#5ebd8a'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><path d='M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z'></path><circle
									cx='12'
									cy='13'
									r='3'></circle></svg
							>
						</div>
						<h3 style="font-family: 'Crimson Pro', serif; font-size: 1.5rem; font-weight: 700; color: white; margin-bottom: 1rem;">
							{t('index.features.memories.title')}
						</h3>
						<p style='color: rgba(255,255,255,0.55); line-height: 1.7; font-weight: 300;'>{t('index.features.memories.desc')}</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Guide / Explore Section -->
		<section style='padding: 6rem 0; position: relative; overflow: hidden;'>
			<div
				style='position: absolute; top: 50%; right: 0; width: 500px; height: 500px; background: rgba(94,189,138,0.04); filter: blur(100px); border-radius: 9999px; pointer-events: none; transform: translateY(-50%);'>
			</div>
			<div style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 10;'>
				<div class='flex flex-col md:flex-row items-center' style='gap: 4rem;'>
					<div class='flex-1 animate-on-scroll'>
						<div
							style='display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(94,189,138,0.1); color: #5ebd8a; font-size: 0.875rem; font-weight: 500; border: 1px solid rgba(94,189,138,0.2); margin-bottom: 1.5rem;'>
							<svg
								xmlns='http://www.w3.org/2000/svg'
								width='14'
								height='14'
								viewBox='0 0 24 24'
								fill='none'
								stroke='currentColor'
								stroke-width='2'
								stroke-linecap='round'
								stroke-linejoin='round'
								><circle cx='12' cy='12' r='10'></circle><polygon points='16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76'
								></polygon></svg
							>
							{t('index.guide.label')}
						</div>
						<h2
							style="font-family: 'Crimson Pro', serif; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; margin-bottom: 2rem; color: white; line-height: 1.15;">
							{t('index.guide.title')}<br /><span style='color: var(--gold); font-style: italic;'>{t('index.guide.title_highlight')}</span>
						</h2>
						<p style='font-size: 1.125rem; color: rgba(255,255,255,0.55); font-weight: 300; line-height: 1.75;'>
							{t('index.guide.desc')}
						</p>
					</div>

					<div class='flex-1 animate-on-scroll' style='transition-delay: 0.2s; width: 100%;'>
						<div
							style='position: relative; border-radius: 2rem; overflow: hidden; aspect-ratio: 4/3; box-shadow: 0 25px 50px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.08);'>
							<Image src={exploreImage} alt='Budapest' loading='eager' class='absolute inset-0 w-full h-full object-cover' />
							<div
								style='position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.45) 50%, rgba(0,0,0,0.1) 100%);'>
							</div>
							<div style='position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem 2rem;'>
								<div
									style='display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0.75rem; border-radius: 9999px; background: rgba(0,0,0,0.55); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.1); margin-bottom: 0.75rem;'>
									<svg
										xmlns='http://www.w3.org/2000/svg'
										width='14'
										height='14'
										viewBox='0 0 24 24'
										fill='none'
										stroke='#5ebd8a'
										stroke-width='2'
										stroke-linecap='round'
										stroke-linejoin='round'
										><path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z'></path><circle cx='12' cy='10' r='3'></circle></svg
									>
									<span style='font-size: 0.75rem; font-weight: 500; color: white;'>{t('index.guide.location')}</span>
								</div>
								<h3 style="font-family: 'Crimson Pro', serif; font-size: 1.75rem; font-weight: 700; color: white; margin-bottom: 0.3rem;">
									{t('index.guide.place_name')}
								</h3>
								<p style='color: rgba(255,255,255,0.65); font-size: 0.875rem;'>{t('index.guide.saved')}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</div>

	<!-- Memories Section -->
	<section
		id='memories'
		style='padding: 6rem 0; background: rgba(255,255,255,0.02); border-top: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05); position: relative; overflow: hidden;'>
		<div
			style='position: absolute; top: 50%; left: 0; width: 500px; height: 500px; background: rgba(94,189,138,0.04); filter: blur(100px); border-radius: 9999px; pointer-events: none; transform: translateY(-50%);'>
		</div>
		<div style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 10;'>
			<div class='flex flex-col-reverse md:flex-row items-center' style='gap: 4rem;'>
				<div
					class='flex-1 animate-on-scroll'
					style='position: relative; display: flex; justify-content: center; align-items: center; padding: 3rem 0; min-height: 28rem;'>
					<div
						style='position: absolute; top: 1rem; right: 2rem; width: 58%; background: white; padding: 0.75rem 0.75rem 3rem; box-shadow: 0 20px 40px rgba(0,0,0,0.4); border-radius: 2px; transform: rotate(9deg); z-index: 0;'>
						<Image src={memoryBg} alt='' style='aspect-ratio: 3/4; width: 100%; object-fit: cover; display: block;' />
					</div>
					<div
						class='polaroid-fg'
						style='position: relative; width: 68%; background: white; padding: 1rem 1rem 4.5rem; box-shadow: 0 25px 50px rgba(0,0,0,0.45); border-radius: 2px; z-index: 10; transform: rotate(-5deg);'>
						<Image
							src={memoryFg}
							alt={t('index.memories.polaroid_name')}
							style='aspect-ratio: 1/1; width: 100%; object-fit: cover; display: block;'
						/>
						<div style='position: absolute; bottom: 1.25rem; left: 0; right: 0; text-align: center; padding: 0rem 2rem;'>
							<p
								style="font-family: 'Crimson Pro', serif; color: rgba(0,0,0,0.88); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.01em; margin-bottom: 0.25rem;">
								{t('index.memories.polaroid_name')}
							</p>
							<p style='color: rgba(0,0,0,0.45); font-size: 0.7rem; font-family: monospace; letter-spacing: 0.15em;'>
								{t('index.memories.polaroid_date')}
							</p>
						</div>
					</div>
				</div>

				<div class='flex-1 animate-on-scroll' style='transition-delay: 0.15s;'>
					<div
						style='display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.75rem; border-radius: 9999px; background: rgba(94,189,138,0.1); color: #5ebd8a; font-size: 0.875rem; font-weight: 500; border: 1px solid rgba(94,189,138,0.2); margin-bottom: 1.5rem;'>
						<svg
							xmlns='http://www.w3.org/2000/svg'
							width='14'
							height='14'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'
							stroke-linejoin='round'
							><path d='M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z'></path><circle
								cx='12'
								cy='13'
								r='3'></circle></svg
						>
						{t('index.memories.label')}
					</div>
					<h2
						style="font-family: 'Crimson Pro', serif; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; margin-bottom: 2rem; color: white; line-height: 1.15;">
						{t('index.memories.title')}
						<span style='color: var(--gold); font-style: italic;'>{t('index.memories.title_highlight')}</span>
					</h2>
					<p style='font-size: 1.125rem; color: rgba(255,255,255,0.55); font-weight: 300; line-height: 1.75;'>
						{t('index.memories.desc')}
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section id='download' style='padding: 8rem 0; position: relative; overflow: hidden;'>
		<div style='position: absolute; inset: 0; background: rgba(94,189,138,0.025);'></div>
		<div
			style='position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 100%; max-width: 900px; height: 500px; background: rgba(94,189,138,0.14); filter: blur(140px); border-radius: 9999px 9999px 0 0; pointer-events: none;'>
		</div>
		<div style='max-width: 1280px; margin: 0 auto; padding: 0 1.5rem; position: relative; z-index: 10; text-align: center;'>
			<div
				class='animate-on-scroll'
				style='max-width: 48rem; margin: 0 auto; background: rgba(20,20,23,0.45); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.09); padding: 4rem 2rem; border-radius: 3rem; box-shadow: 0 25px 60px rgba(0,0,0,0.4);'>
				<h2
					style="font-family: 'Crimson Pro', serif; font-size: clamp(2.5rem, 7vw, 4.5rem); font-weight: 700; margin-bottom: 2rem; color: white; line-height: 1.1;">
					{t('index.cta.title')}
					<span style='color: var(--gold); font-style: italic;'>{t('index.cta.title_highlight')}</span>
				</h2>
				<p style='font-size: 1.125rem; color: rgba(255,255,255,0.55); font-weight: 300; line-height: 1.75; max-width: 30rem; margin: 0 auto 3rem;'>
					{t('index.cta.desc')}
				</p>
				<div class='flex flex-col sm:flex-row items-center justify-center' style='gap: 1rem;'>
					<a
						href='#'
						style='display: flex; align-items: center; justify-content: center; width: 100%; max-width: 16rem; height: 4rem; padding: 0 2.5rem; border-radius: 9999px; background: #5ebd8a; color: black; font-size: 1.125rem; font-weight: 700; text-decoration: none; box-shadow: 0 0 30px rgba(94,189,138,0.3); transition: background 0.2s;'
						onmouseover="this.style.background='#4fa877'"
						onmouseout="this.style.background='#5ebd8a'">
						{t('index.cta.ios')}
					</a>
