---
import { getLangFromUrl, useTranslations } from '../i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<section id='_contactus' class='border-0 flex  mt-12 flex-row min-h-24 w-[50%]'>
	<div class='flex py-4 px-4 rounded-lg border-blue-800 shadow-xl border-0 w-full bg-white'>
		<div class='flex flex-col'>
			<h1 class='font-inter font-bold text-2xl'>{t('nav.contactus')}</h1>
      <span class="font-medium mt-1">{t('contactus.subtitle')} </span>
			<div class='flex flex-col px-0 mt-4 gap-2'>
				<span>{t('contactus.name')}: Győrfy Máté </span>
				<span>{t('contactus.email')}: brendoapptest@gmail.com</span>
      </div>
		</div>
	</div>
</section>
